+/**
+ * Buffered IoU (BIoU)
+ *
+ * Inflate every box about its center by a size-proportional buffer
+ * (w -> (1 + 2*buffer_ratio)*w, h -> (1 + 2*buffer_ratio)*h) for BOTH box sets,
+ * then return standard IoU on the inflated boxes. Small/fast boxes whose plain IoU
+ * collapses to ~0 between frames still overlap once buffered, so they stay
+ * associated. Output stays in [0,1] (it is plain IoU on larger boxes), so no
+ * rescaling is needed and the iou_threshold gate applies directly — though, since
+ * inflation only raises overlap, a given threshold is more permissive than plain IoU.
+ * This is the core mechanism of C-BIoU (Yang et al., WACV 2023) used as a single
+ * association metric. Input boxes are [x1, y1, x2, y2(, ...)]; extra columns ignored.
+ */
+inline Eigen::MatrixXf biou_batch(const Eigen::MatrixXf& bboxes1,
+                                  const Eigen::MatrixXf& bboxes2,
+                                  float buffer_ratio = 0.3f) {
+    int N = static_cast<int>(bboxes1.rows());
+    int M = static_cast<int>(bboxes2.rows());
+
+    if (N == 0 || M == 0) {
+        return Eigen::MatrixXf::Zero(N, M);
+    }
+
+    auto inflate = [buffer_ratio](const Eigen::MatrixXf& b) {
+        Eigen::VectorXf w = b.col(2) - b.col(0);
+        Eigen::VectorXf h = b.col(3) - b.col(1);
+        Eigen::MatrixXf out(b.rows(), 4);
+        out.col(0) = b.col(0).array() - buffer_ratio * w.array();
+        out.col(1) = b.col(1).array() - buffer_ratio * h.array();
+        out.col(2) = b.col(2).array() + buffer_ratio * w.array();
+        out.col(3) = b.col(3).array() + buffer_ratio * h.array();
+        return out;
+    };
+
+    return iou_batch(inflate(bboxes1), inflate(bboxes2));
+}
