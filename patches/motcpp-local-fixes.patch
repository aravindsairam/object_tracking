+// Regression: the variant association metrics (giou/diou/ciou/hmiou) are vectorized
+// with Eigen broadcasting and must produce an N×M matrix for a TRUE batch (N>1, M>1).
+// A 1×1 input cannot catch a row-vs-column broadcast bug, so these use a 2×3 batch
+// with two exact self-matches and assert each self-match is the max of its row.
+// (Before the broadcast fix, these threw on the dimension mismatch / read OOB.)
+class VariantBatchTest : public ::testing::Test {
+protected:
+    void SetUp() override {
+        a_ = Eigen::MatrixXf(2, 4);
+        a_ << 0, 0, 100, 100,
+              200, 200, 300, 300;
+        b_ = Eigen::MatrixXf(3, 4);
+        b_ << 0, 0, 100, 100,          // == a_[0]
+              50, 50, 150, 150,        // partial overlap with a_[0]
+              200, 200, 300, 300;      // == a_[1]
+    }
+    Eigen::MatrixXf a_, b_;
+
+    // self-match at (row, selfCol) must be 1.0 and the largest entry in its row.
+    void checkSelfMatchDominates(const Eigen::MatrixXf& m, int row, int selfCol) {
+        ASSERT_EQ(m.rows(), 2);
+        ASSERT_EQ(m.cols(), 3);
+        EXPECT_NEAR(m(row, selfCol), 1.0f, 1e-4f);
+        for (int j = 0; j < m.cols(); ++j)
+            if (j != selfCol) EXPECT_GE(m(row, selfCol), m(row, j));
+    }
+};
+
+TEST_F(VariantBatchTest, GIoUBatchShapeAndSelfMatch) {
+    Eigen::MatrixXf m = giou_batch(a_, b_);
+    checkSelfMatchDominates(m, 0, 0);
+    checkSelfMatchDominates(m, 1, 2);
+}
+
+TEST_F(VariantBatchTest, DIoUBatchShapeAndSelfMatch) {
+    Eigen::MatrixXf m = diou_batch(a_, b_);
+    checkSelfMatchDominates(m, 0, 0);
+    checkSelfMatchDominates(m, 1, 2);
+}
+
+TEST_F(VariantBatchTest, CIoUBatchShapeAndSelfMatch) {
+    Eigen::MatrixXf m = ciou_batch(a_, b_);
+    checkSelfMatchDominates(m, 0, 0);
+    checkSelfMatchDominates(m, 1, 2);
+}
+
+TEST_F(VariantBatchTest, HMIoUBatchShapeAndSelfMatch) {
+    Eigen::MatrixXf m = hmiou_batch(a_, b_);
+    checkSelfMatchDominates(m, 0, 0);
+    checkSelfMatchDominates(m, 1, 2);
+}
+
+TEST_F(VariantBatchTest, BIoUBatchShapeAndSelfMatch) {
+    Eigen::MatrixXf m = biou_batch(a_, b_, 0.3f);
+    checkSelfMatchDominates(m, 0, 0);
+    checkSelfMatchDominates(m, 1, 2);
+}
+
+// BIoU's purpose: a near-miss pair (plain IoU == 0) gains overlap once buffered.
+// Two 100px boxes one box-width apart (edges touch at x=100) -> plain IoU 0; a
+// large-enough buffer inflates both so they overlap -> biou > 0.
+TEST(BIoUTest, BufferCreatesOverlapForNearMiss) {
+    Eigen::MatrixXf d(1, 4); d << 0, 0, 100, 100;
+    Eigen::MatrixXf t(1, 4); t << 100, 0, 200, 100;   // adjacent, no overlap
+
+    EXPECT_FLOAT_EQ(iou_batch(d, t)(0, 0), 0.0f);     // plain IoU: no overlap
+    EXPECT_FLOAT_EQ(biou_batch(d, t, 0.0f)(0, 0), 0.0f);  // zero buffer == plain IoU
+    EXPECT_GT(biou_batch(d, t, 0.5f)(0, 0), 0.0f);    // buffered: now overlaps
+    // Larger buffer -> more overlap -> higher BIoU.
+    EXPECT_GT(biou_batch(d, t, 0.8f)(0, 0), biou_batch(d, t, 0.5f)(0, 0));
+}
+
+// The selector path the trackers use must honor the buffer_ratio ctor arg.
+TEST(BIoUTest, AssociationFunctionBIoUUsesBufferRatio) {
+    Eigen::MatrixXf d(1, 4); d << 0, 0, 100, 100;
+    Eigen::MatrixXf t(1, 4); t << 100, 0, 200, 100;
+    AssociationFunction no_buffer(640, 480, "biou", 0.0f);
+    AssociationFunction buffered(640, 480, "biou", 0.5f);
+    EXPECT_FLOAT_EQ(no_buffer(d, t)(0, 0), 0.0f);
+    EXPECT_GT(buffered(d, t)(0, 0), 0.0f);
+}
+
+// The selector path used by the trackers (asso_func string) must also handle a batch.
+TEST_F(VariantBatchTest, AssociationFunctionDIoUBatch) {
+    AssociationFunction asso(640, 480, "diou");
+    Eigen::MatrixXf m = asso(a_, b_);
+    checkSelfMatchDominates(m, 0, 0);
+    checkSelfMatchDominates(m, 1, 2);
+}
